# ─────────────────────────────────────────────────────────────────────────────
# Enterprise RAG — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME="Enterprise RAG Knowledge Assistant"
DEBUG=false
SECRET_KEY=replace-with-32-char-random-string-openssl-rand-hex-32

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: openai | watsonx | huggingface
LLM_PROVIDER=openai

# OpenAI (if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0

# Watsonx.ai (if LLM_PROVIDER=watsonx)
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=meta-llama/llama-3-70b-instruct

# ── Embeddings ───────────────────────────────────────────────────────────────
# Local (no API key): BAAI/bge-m3  |  sentence-transformers/all-MiniLM-L6-v2
# OpenAI: text-embedding-3-large (requires OPENAI_API_KEY)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ── Vector Store ─────────────────────────────────────────────────────────────
# Options: chroma | pinecone
VECTOR_STORE_BACKEND=chroma
CHROMA_PERSIST_DIR=./data/chroma_db

# Pinecone (if VECTOR_STORE_BACKEND=pinecone)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=enterprise-rag
PINECONE_ENVIRONMENT=us-east-1

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Retrieval ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RERANK_TOP_N=5
SIMILARITY_THRESHOLD=0.30
USE_HYBRID_SEARCH=true
USE_RERANKER=true

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── Redis (optional — for response caching) ───────────────────────────────────
REDIS_URL=
CACHE_TTL_SECONDS=3600

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
